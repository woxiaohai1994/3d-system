{"hashes":{"vendor/blender-rig-object-transform/transform_orientations.cc":"76efe71179ceecf3c7001a9d4eb6c7805807ec8bece0c95ff73869ab82d460ef","vendor/blender-rig-pose-local-orientation/transform_orientations.hh":"508f53339c25fdd02fb6092fd9f0f0a7f7b7666bf6dc319e399fe43a7c8e4c1e","vendor/blender-transform-translation/math_matrix_c.cc":"42af477e6a16067244e3d7050026d9ef2c20296bf4401a77074c33f33cdc4764","vendor/blender-transform-angle/math_vector_inline.c":"f43528fd8ac6efa045bf11e96764cc08849e2837e96876e079508c73178b13b9","scripts/blender/compile-rig-pose-local-orientation.py":"9f9e7d38a86881eae91a8340ca662d167f91d3211195b67c644bfd1f219d9537"},"wasm":"","wasmHash":"110958ffc8f7b822380248109833df54a0181f4f58a51598141a29e6fff42e30","sourceBlocks":{"poseAxes":"      add_v3_v3(normal, pchan->pose_mat[2]);\n      add_v3_v3(plane, pchan->pose_mat[1]);","normalTransform":"      copy_m3_m4(imat, ob->object_to_world().ptr());\n\n      invert_m3_m3(mat, imat);\n      transpose_m3(mat);\n      mul_m3_v3(mat, normal);\n      mul_m3_v3(mat, plane);","orientationConstruction":"  /* Fallback, when the plane can't be calculated. */\n  if (ORIENTATION_USE_PLANE(type) && is_zero_v3(plane)) {\n    type = ORIENTATION_VERT;\n  }\n\n  switch (type) {\n    case ORIENTATION_NORMAL:\n      if (createSpaceNormalTangent(r_orientation_mat, normal, plane) == 0) {\n        type = ORIENTATION_NONE;\n      }\n      break;\n    case ORIENTATION_VERT:\n      if (createSpaceNormal(r_orientation_mat, normal) == 0) {\n        type = ORIENTATION_NONE;\n      }\n      break;\n    case ORIENTATION_EDGE:\n      if (createSpaceNormalTangent(r_orientation_mat, normal, plane) == 0) {\n        type = ORIENTATION_NONE;\n      }\n      break;\n    case ORIENTATION_FACE:\n      if (createSpaceNormalTangent(r_orientation_mat, normal, plane) == 0) {\n        type = ORIENTATION_NONE;\n      }\n      break;\n    default:\n      BLI_assert(type == ORIENTATION_NONE);\n      break;\n  }\n","failureFallback":"  if (type == ORIENTATION_NONE) {\n    unit_m3(r_orientation_mat);\n  }","orientationEnum":"enum {\n  ORIENTATION_NONE = 0,\n  ORIENTATION_NORMAL = 1,\n  ORIENTATION_VERT = 2,\n  ORIENTATION_EDGE = 3,\n  ORIENTATION_FACE = 4,\n};\n#define ORIENTATION_USE_PLANE(ty) ELEM(ty, ORIENTATION_NORMAL, ORIENTATION_EDGE, ORIENTATION_FACE)"}}
