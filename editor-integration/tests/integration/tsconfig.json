{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*.ts",
    "../../scripts/integration-*.ts",
    "../../docs/integration/audit/*-browser-probe.ts",
    "../../docs/integration/audit/browser-entry.ts"
  ]
}
